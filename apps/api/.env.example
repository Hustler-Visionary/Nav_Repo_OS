# Copy to .env for local development. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# Required, no built-in default. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Comma-separated list of allowed origins (e.g. http://localhost:3000,https://app.example.com).
# Leave unset in dev to default to http://localhost:3000 (apps/web); leave unset in production for no cross-origin access.
CORS_ORIGIN=

# Optional, opt-in: seeds one ADMIN account at boot if both are set. Never set a weak password here.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
