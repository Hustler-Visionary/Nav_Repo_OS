# Repo that the graph explorer + Monaco code viewer point at.
# Defaults to this app's own parent directory (today's self-hosted setup,
# where web/ lives inside the repo it visualizes).
# TARGET_REPO_ROOT=/absolute/path/to/another/repo

# Relative paths (inside TARGET_REPO_ROOT) scanned for each nav view.
# TARGET_SRC_PATH=src
# TARGET_DOMAIN_PATH=src/domain
# TARGET_UI_PATH=src/components

# Note: only the graph/code-reading parts respect these. The chat's
# execute-intent.ts and the UI preview's ui-preview-samples.ts import
# specific functions from *this* repo's src/domain at build time -- those
# stay tied to this demo's own domain model until rebuilt for a real target.
